#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "Usage: $(basename "$0") <video-file> [output-dir]" >&2
  exit 1
fi

VIDEO="$1"

if [[ ! -f "$VIDEO" ]]; then
  echo "Error: file not found: $VIDEO" >&2
  exit 1
fi

BASENAME="$(basename "$VIDEO")"
NAME="${BASENAME%.*}"
OUT_DIR="${2:-$(dirname "$VIDEO")}"
BASE="${OUT_DIR}/${NAME}_audio"

echo "Extracting MP3..."
ffmpeg -y -i "$VIDEO" -vn -ar 16000 -ac 1 -acodec libmp3lame -b:a 32k "${BASE}.mp3"

echo "Done: ${BASE}.mp3"
